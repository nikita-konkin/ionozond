[Unit]
# Copy derived products to the NAS, and delete local .h5 the NAS has verified.
# One unit for both halves on purpose -- see tools/nas_sync.py on why an
# uploader and a pruner that do not know about each other agree only by luck.
Description=ionozond NAS sync
Documentation=https://github.com/nikita-konkin/ionozond
After=ionozond-sounder.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/ionozond
User=samsung
Group=samsung
WorkingDirectory=/home/samsung/projects/ionozond

# NAS_DEST empty means the station has no NAS, which is not a failure. Without
# this the timer would mail a failure every hour on a perfectly healthy host.
# systemd expands ${NAS_DEST} itself before sh runs, and an unset or empty
# one expands to an empty argument, so this reads `test -n ""` and the
# unit is skipped. sh's own ${VAR:-} syntax would NOT work here: systemd
# does not implement it and would look for a variable named "NAS_DEST:-".
ExecCondition=/bin/sh -c 'test -n "${NAS_DEST}"'

# NAS_KEEP_H5_DAYS is a floor in the same sense as PRUNE_KEEP_DAYS: local .h5
# newer than it are never deleted. Nothing is deleted at all unless rsync has
# just confirmed, by checksum, that the NAS holds the same bytes.
ExecStart=/usr/bin/python3 tools/nas_sync.py ${IONOZOND_ARCHIVE} \
    --dest ${NAS_DEST} --keep-h5-days ${NAS_KEEP_H5_DAYS} \
    --bwlimit ${NAS_BWLIMIT} --ssh-key ${NAS_SSH_KEY} --apply

# The sounder is receiving at 100 MB/s onto the same disk and through the same
# host. Uploading is never urgent enough to compete with that.
IOSchedulingClass=idle
Nice=19

# A hung SSH session is the failure mode that matters: rsync's own --timeout
# handles a stalled transfer, and this handles everything else -- DNS, an
# unreachable host, a NAS that accepts the connection and never answers.
TimeoutStartSec=3600
