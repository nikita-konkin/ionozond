[Unit]
# Copy derived products to the NAS, and delete local .h5 the NAS has verified.
# One unit for both halves on purpose -- see tools/nas_sync.py on why an
# uploader and a pruner that do not know about each other agree only by luck.
Description=ionozond NAS sync
Documentation=https://github.com/nikita-konkin/ionozond
After=ionozond-sounder.service network-online.target
Wants=network-online.target

# If the destination is a mounted share, add the mount point here in a drop-in
# so systemd triggers the automount and waits for it:
#
#     sudo systemctl edit ionozond-nas.service
#     [Unit]
#     RequiresMountsFor=/mnt/ionozond_16tb
#
# Not in this file because the path is the station's, not the project's.

[Service]
Type=oneshot
EnvironmentFile=/etc/default/ionozond
User=samsung
Group=samsung
WorkingDirectory=/home/samsung/projects/ionozond

# The destination and the retention window come from the console's parameters
# dialog, through chirp_config.py, like every other setting the operator can
# change. NAS_DEST and NAS_KEEP_H5_DAYS in /etc/default are read by
# nas_sync.py itself as a fallback for a host with no console, and are
# deliberately NOT passed as flags here: a flag would outrank the dialog, and
# the dialog is where anyone will look first.
#
# A station with no NAS configured anywhere exits 0 with a line saying so. An
# hourly timer that fails on a healthy host is how an operator learns to
# ignore its failures.
ExecStart=/usr/bin/python3 tools/nas_sync.py ${IONOZOND_ARCHIVE} \
    --config ${IONOZOND_CONFIG} --bwlimit ${NAS_BWLIMIT} \
    --ssh-key ${NAS_SSH_KEY} --apply

# The sounder is receiving at 100 MB/s onto the same disk and through the same
# host. Uploading is never urgent enough to compete with that.
IOSchedulingClass=idle
Nice=19

# A hung SSH session is the failure mode that matters: rsync's own --timeout
# handles a stalled transfer, and this handles everything else -- DNS, an
# unreachable host, a NAS that accepts the connection and never answers.
TimeoutStartSec=3600
