[Unit]
Description=ionozond NAS sync, hourly
Documentation=https://github.com/nikita-konkin/ionozond

[Timer]
OnCalendar=hourly
# Offset from the pruner's window as well as from the hour. Both touch the
# same files, and the sounder is most likely to be mid-capture on the hour.
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
