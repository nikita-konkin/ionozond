[Unit]
# Continuous chirp sounding, with no operator logged in.
#
# Install with tools/host-setup/18-install-service.sh, which writes the site
# settings to /etc/default/ionozond and enables this. Then:
#
#   systemctl status ionozond-sounder
#   journalctl -u ionozond-sounder -f
#
# NOT alongside the console's START button. Both open the same radio, and the
# second one to try will fail. Use the service for unattended operation and the
# console for looking at what it produced; press START only when the service is
# stopped.
Description=ionozond chirp sounder
Documentation=https://github.com/nikita-konkin/ionozond
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Site settings: RADIO_ADDR, JUMBO, IONOZOND_CONFIG, IONOZOND_ARCHIVE, IFACE.
# Written by 18-install-service.sh; edit it rather than this unit, so an
# upgrade does not overwrite the station's own values.
EnvironmentFile=/etc/default/ionozond

# The radio link must be up before the USRP can be found. NetworkManager brings
# usrp-link up on boot only if its autoconnect is enabled -- see
# tools/host-setup/README.md, step 2.
ExecStartPre=/bin/sh -c 'until ping -c1 -W1 "$RADIO_ADDR" >/dev/null 2>&1; do sleep 2; done'

# Restore the NIC receive ring. The NetworkManager dispatcher installed by
# 12-host-tuning.sh normally does this, but it is cheap insurance and the
# measured cost of getting it wrong was 5.8 million missed frames. The leading
# + runs this step as root even though the service itself does not.
ExecStartPre=+/bin/sh -c 'ethtool -G "$IFACE" rx 4096 2>/dev/null || true'

# Through sounder.sh rather than straight to rx_dechirp.py, so the service and
# the console's START button take exactly the same path and JUMBO applies to
# both.
ExecStart=/bin/bash tools/sounder.sh ${IONOZOND_CONFIG} ${IONOZOND_ARCHIVE}

WorkingDirectory=/home/samsung/projects/ionozond

# Run as the operator, not root.
User=samsung
Group=samsung
SupplementaryGroups=usrp

# The whole point of running under systemd: the real-time limit is granted to
# the service directly, so none of the login-session business applies. Without
# it UHD cannot raise its receive thread priority and drops samples under load.
LimitRTPRIO=99
LimitMEMLOCK=infinity

# SIGTERM is handled: the sounder finishes the capture in progress rather than
# leaving a truncated file behind. A 250 s sounding needs room to finish.
KillSignal=SIGTERM
TimeoutStopSec=300

# Restart on failure, but slowly. A sounder respawning every second against a
# radio that is not there fills the journal and hides the actual problem. The
# sounder already stops itself after three empty soundings in a row.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
