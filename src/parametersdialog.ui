        <property name="singleStep"><number>2</number></property></widget></item>

       <item row="17" column="0"><widget class="QLabel" name="lblObjLevel">
        <property name="text"><string>порог соседей:</string></property></widget></item>
       <item row="17" column="1"><widget class="QDoubleSpinBox" name="spbObjLevel">
