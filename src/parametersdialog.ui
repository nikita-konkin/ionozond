        <property name="minimum"><double>0.0</double></property>
        <property name="maximum"><double>2601.0</double></property>
        <property name="singleStep"><double>1.0</double></property></widget></item>
       <item row="17" column="2" colspan="3"><widget class="QLabel" name="lblObjLevelHint">
